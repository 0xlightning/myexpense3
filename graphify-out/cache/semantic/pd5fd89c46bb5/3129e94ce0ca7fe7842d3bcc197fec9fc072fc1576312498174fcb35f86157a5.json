{"nodes": [{"id": "docs_project_spec", "label": "MyExpenseLog Project Spec", "file_type": "document", "source_file": "docs/project-spec.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_project_spec_myexpenselog", "label": "MyExpenseLog", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L1-L8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Personal finance ledger for one signed-in user logging income, expenditure and investments; net worth is derived, never stored."}, {"id": "docs_project_spec_net_worth_formula", "label": "Net Worth Formula (Sum income - Sum expenditure - Sum investments)", "file_type": "rationale", "source_file": "docs/project-spec.md", "source_location": "L6-L8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Derived on every render from the three record totals and never cached or stored (Core decisions)."}, {"id": "docs_project_spec_data_model", "label": "users/{uid} Data Model", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L18-L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three record collections plus three category collections instead of one transactions table, because income uses sources while expenditure and investment use categories (different vocabulary)."}, {"id": "docs_project_spec_income_sources", "label": "income_sources collection", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L26", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_project_spec_income_records", "label": "income_records collection", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_project_spec_expense_categories", "label": "expense_categories collection", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L28", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_project_spec_expenditure_records", "label": "expenditure_records collection", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_project_spec_investment_categories", "label": "investment_categories collection", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L30", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_project_spec_investments", "label": "investments collection", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L31", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_project_spec_record_field_rules", "label": "Record Field Rules", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L34-L43", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_project_spec_utc_midnight_iso_date", "label": "UTC-Midnight ISO Dates", "file_type": "rationale", "source_file": "docs/project-spec.md", "source_location": "L37", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dates stored as UTC-midnight ISO strings so month/year bucketing is timezone-safe."}, {"id": "docs_project_spec_category_name_uniqueness", "label": "Case-Insensitive Name Uniqueness per Collection", "file_type": "rationale", "source_file": "docs/project-spec.md", "source_location": "L41-L43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Names are trimmed, 1-40 chars and unique case-insensitively only within their own collection, so 'Salary' may exist as both an income source and an expense category; enforced client-side as UX, not by rules."}, {"id": "docs_project_spec_other_label", "label": "\"Other\" Read-Time Label", "file_type": "rationale", "source_file": "docs/project-spec.md", "source_location": "L45-L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Other is never a document; null and unresolvable category/source IDs fall back to it at read time, so deleting a category can never orphan or corrupt a record and nothing is rewritten."}, {"id": "docs_project_spec_kind_metadata_table", "label": "Kind Metadata Table", "file_type": "rationale", "source_file": "docs/project-spec.md", "source_location": "L65-L74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single source of truth (label, records collection, category collection, FK field, category noun, sign +1/-1) driving the record page, category page and dashboard; a 4th kind costs one row plus one route."}, {"id": "docs_project_spec_route_table", "label": "Route Table (/login, /, /income, /expenditure, /investments, /category)", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L50-L59", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_project_spec_generic_record_page", "label": "Generic Record Page", "file_type": "rationale", "source_file": "docs/project-spec.md", "source_location": "L61-L63", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One page serves income, expenditure and investment via the metadata table instead of three near-identical pages."}, {"id": "docs_project_spec_categories_page", "label": "Categories Page (/category)", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L76-L109", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One route with three metadata-driven panels (tabs on mobile, columns at lg) for all category collections, because three near-identical pages would drift; the only place categories are created."}, {"id": "docs_project_spec_category_rename", "label": "Category Rename via Doc-ID Reference", "file_type": "rationale", "source_file": "docs/project-spec.md", "source_location": "L99-L101", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records reference the category doc id, so renaming relabels every record and chart slice on the next snapshot with no data migration."}, {"id": "docs_project_spec_non_cascading_delete", "label": "Non-Cascading Category Delete", "file_type": "rationale", "source_file": "docs/project-spec.md", "source_location": "L102-L106", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "deleteDoc touches no records; their FK becomes unresolvable and renders as Other, so a delete can never destroy or corrupt a record. The confirm dialog states the affected record count."}, {"id": "docs_project_spec_dashboard", "label": "Dashboard (/)", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L111-L114", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every number is derived at render time from the shared Redux slices; nothing is cached or stored."}, {"id": "docs_project_spec_stat_cards", "label": "Stat Cards", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L116-L136", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Net worth is the hero card and always carries a sign character so meaning is never colour-alone; cards use proportional figures, tabular-nums is reserved for tables."}, {"id": "docs_project_spec_skeleton_loading", "label": "Skeleton Before First Snapshot", "file_type": "rationale", "source_file": "docs/project-spec.md", "source_location": "L135-L136", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cards show a skeleton until the first snapshot lands and only then render a real 0 (not a dash), so loading is never shown as zero."}, {"id": "docs_project_spec_split_donuts", "label": "Split Donut Charts", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L138-L162", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_project_spec_donut_color_palette", "label": "Fixed Donut Colour Palette", "file_type": "rationale", "source_file": "docs/project-spec.md", "source_location": "L164-L195", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eight fixed slots, never cycled, keyed to category createdAt order rather than slice rank so sorting or filtering never repaints survivors; 9th+ categories fold into Other (muted grey #898781, not a slot); explicit dark column rather than auto flip; surfaces #fcfcfb/#1a1a19; text stays in ink tokens."}, {"id": "docs_project_spec_chart_table_fallback", "label": "Donut Table-View Fallback", "file_type": "rationale", "source_file": "docs/project-spec.md", "source_location": "L155-L157", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A toggle renders each donut as a two-column table: the accessibility fallback and required relief for any sub-3:1 colour on the light surface."}, {"id": "docs_project_spec_zero_value_category_rule", "label": "Zero-Value Categories Not Drawn", "file_type": "rationale", "source_file": "docs/project-spec.md", "source_location": "L158-L160", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A category with no records would be invisible 0% geometry with a live legend entry, so such categories are listed under the chart as 'N categories with no records yet'."}, {"id": "docs_project_spec_data_flow", "label": "Auth-to-Redux Snapshot Data Flow", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L197-L212", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Six listeners (three record, three category collections) mount together so /category edits and dashboard charts update from the same Firestore echo with no refetch; writes go straight to Firestore."}, {"id": "docs_project_spec_redux_slices", "label": "Redux Slices (one per collection + auth)", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L330-L333", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Totals and splits are selectors, never stored in state."}, {"id": "docs_project_spec_firestore_security_rules", "label": "Firestore Security Rules (owner-only users/{uid}/**)", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L214-L233", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With no server, rules are the only access control: read/write only when request.auth.uid == uid, everything else denied; rules intentionally do not validate document shape (client validator's job, UX not security)."}, {"id": "docs_project_spec_no_server_architecture", "label": "No-Server Architecture (Firebase free tier)", "file_type": "rationale", "source_file": "docs/project-spec.md", "source_location": "L15-L16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Free tier only with no server or Cloud Functions, which makes Firestore Security Rules the sole access-control layer."}, {"id": "docs_project_spec_firebase_setup", "label": "Firebase Project Setup", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L235-L252", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rules are deployed before real data lands."}, {"id": "docs_project_spec_env_local_config", "label": ".env.local Firebase Config (VITE_FIREBASE_*)", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L240-L249", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_project_spec_firebase_json", "label": "firebase.json Hosting and Rules Config", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L254-L265", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hosting serves dist with an SPA rewrite of every path to /index.html so client-side routes resolve; firestore section points at firestore.rules and firestore.indexes.json."}, {"id": "docs_project_spec_firebase_auth", "label": "Firebase Auth (email/password)", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_project_spec_firestore", "label": "Cloud Firestore", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_project_spec_firebase_hosting", "label": "Firebase Hosting", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_project_spec_redux_toolkit", "label": "Redux Toolkit (react-redux)", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L12", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_project_spec_recharts", "label": "Recharts", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_project_spec_shadcn_ui", "label": "shadcn/ui (Radix UI)", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_project_spec_tailwind_css", "label": "Tailwind CSS", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_project_spec_vite", "label": "Vite", "file_type": "concept", "source_file": "docs/project-spec.md", "source_location": "L336", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_project_spec", "target": "docs_project_spec_myexpenselog", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/project-spec.md", "source_location": "L1-L4", "weight": 1.0}, {"source": "docs_project_spec_myexpenselog", "target": "docs_project_spec_net_worth_formula", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/project-spec.md", "source_location": "L6-L8", "weight": 1.0}, {"source": "docs_project_spec_myexpenselog", "target": "docs_project_spec_data_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/project-spec.md", "source_location": "L297-L306", "weight": 1.0}, {"source": "docs_project_spec_myexpenselog", "target": "docs_project_spec_no_server_architecture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/project-spec.md", "source_location": "L15-L16", "weight": 1.0}, {"source": "docs_project_spec_myexpenselog", "target": "docs_project_spec_route_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/project-spec.md", "source_location": "L308-L314", "weight": 1.0}, {"source": "docs_project_spec_data_model", "target": "docs_project_sp