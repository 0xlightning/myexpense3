{"nodes": [{"id": "claude", "label": "CLAUDE.md MyExpenseLog Agent Instructions", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_non_negotiable_rules", "label": "Non-negotiable Rules", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L32-L43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guardrails keeping the app serverless, uid-scoped, secret-free and non-destructive: no server/Cloud Function/Admin SDK/service account, no stored totals/net worth/splits/counts, no access outside users/{uid}/, no committed .env.local, no cascade delete or record rewrite on category change, preserve the donut palette, justify every new dependency, no unrelated refactors."}, {"id": "claude_security_rules_requirement", "label": "Firestore Security Requirements and Review", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L129-L138", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rules must require request.auth != null and request.auth.uid == uid and deny all other documents/users; any change to Auth, Firestore paths or rules must be reviewed against docs/firebase-security.md to verify no cross-user read or write is possible."}, {"id": "claude_derived_logic_selectors", "label": "Pure Derived-Logic Selectors", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L86-L104", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Totals, net worth, record/category counts, bucket splits and resolved names (unresolved IDs -> Other) are computed by pure selectors or utilities instead of being stored; investment amounts count negative in net worth."}, {"id": "claude_shared_metadata_architecture", "label": "Shared Kind-Metadata Architecture", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L106-L112", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One metadata table drives record routes, record forms, category panels, dashboard selectors and chart labels so three record pages are never duplicated and a new kind needs only one metadata entry plus its route."}, {"id": "claude_centralized_firebase_access", "label": "Centralized Firebase Access and Path Construction", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L113-L114", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_ui_boundary_validation", "label": "UI-Boundary Write Validation", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L116-L127", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Amount, UTC date, notes length and name checks run before every write to improve UX; client validation is explicitly not security and Firestore rules remain the security boundary."}, {"id": "claude_listener_lifecycle", "label": "Snapshot Listener Lifecycle and Loading State", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L71-L84", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Six onSnapshot listeners mount after sign-in and are unsubscribed on sign-out and effect cleanup; snapshots rather than local writes are authoritative, and auth/collection loading is explicit so a legitimate zero is never rendered before the first snapshot."}, {"id": "claude_ui_rules", "label": "UI Rules", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L140-L152", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accessible presentation: skeletons instead of zero while loading, tabular-nums only in table columns, signed net worth so colour is never the only cue, preserved light/dark donut palette and surfaces, chart table fallback, no categorical chart colour as text."}, {"id": "claude_verification_checklist", "label": "Testing and Verification Checklist", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L154-L172", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_project_commands", "label": "Build and Deploy Commands", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L20-L30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "npm run build after meaningful changes; firebase deploy only when the user explicitly asks."}, {"id": "claude_git_conventions", "label": "Git Commit Conventions", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L174-L183", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_optional_workflows", "label": "Optional Agent Workflows (/graphify, /ponytail, /taste, /impeccable, /review)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L185-L192", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude", "target": "docs_project_spec", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "L8", "weight": 1.0}, {"source": "claude_security_rules_requirement", "target": "docs_firebase_security", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "L137-L138", "weight": 1.0}, {"source": "claude_security_rules_requirement", "target": "docs_project_spec_firestore_security_rules", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "CLAUDE.md", "source_location": "L131-L135", "weight": 1.0}, {"source": "claude_non_negotiable_rules", "target": "docs_project_spec_donut_color_palette",